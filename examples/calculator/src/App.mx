import { morphState } from 'morph'

import "style.css"

export const windowConfig = {
  title: "Calculator",
  width: 360,
  height: 560,
  minWidth: 360,
  minHeight: 560,
  maxWidth: 360,
  maxHeight: 560,
}

// opcodes: 0 none, 1 +, 2 -, 3 x, 4 /
function compute(a:double, b:double, k:int):double {
  if (k === 1) return a + b;
  if (k === 2) return a - b;
  if (k === 3) return a * b;
  if (k === 4) return a / b; // divide by zero => inf/nan => "Error"
  return b;                  // k=0: first operand, result is just b
}

export default function App() {
  const [cur, setCur] = morphState(0.0);
  const [acc, setAcc] = morphState(0.0);
  const [op, setOp] = morphState(0);
  const [opSym, setOpSym] = morphState("");
  const [fresh, setFresh] = morphState(1);
  const [dot, setDot] = morphState(0);
  const [dp, setDp] = morphState(0.1);
  // Last completed expression, shown on top after "=" (e.g. 5 + 3 =).
  const [histA, setHistA] = morphState(0.0);
  const [histOp, setHistOp] = morphState("");
  const [histB, setHistB] = morphState(0.0);
  const [done, setDone] = morphState(0);

  function pressDigit(d:double):void {
    setDone(0);
    if (fresh === 1) {
      setCur(d);
      setFresh(0);
      setDot(0);
      setDp(0.1);
    } else if (dot === 1) {
      setCur(cur + d * dp);
      setDp(dp / 10);
    } else {
      setCur(cur * 10 + d);
    }
  }

  function pressDot():void {
    setDone(0);
    if (dot === 0) {
      if (fresh === 1) {
        setCur(0.0);
        setFresh(0);
      }
      setDot(1);
      setDp(0.1);
    }
  }

  function pressOp(k:int):void {
    setAcc(compute(acc, cur, op));
    setDone(0);
    setOp(k);
    setOpSym(k === 1 ? "+" : (k === 2 ? "-" : (k === 3 ? "x" : "/")));
    setFresh(1);
    setDot(0);
    setDp(0.1);
  }

  function pressEquals():void {
    if (op !== 0) {
      setHistA(acc);
      setHistOp(opSym);
      setHistB(cur);
      setCur(compute(acc, cur, op));
      setAcc(0);
      setOp(0);
      setOpSym("");
      setDone(1);
    } else {
      setDone(0);
    }
    setFresh(1);
    setDot(0);
    setDp(0.1);
  }

  function pressClear():void {
    setCur(0.0);
    setAcc(0.0);
    setOp(0);
    setOpSym("");
    setHistA(0.0);
    setHistOp("");
    setHistB(0.0);
    setDone(0);
    setFresh(1);
    setDot(0);
    setDp(0.1);
  }

  function pressNeg():void {
    if (cur !== 0) setCur(-cur);
  }

  function pressPct():void {
    setCur(cur / 100);
  }

  // Physical keyboard: same actions as the buttons. The pressed look
  // is a class toggle (browser/React approach): keyDown records which
  // key is held in activeKey, keyUp clears it, and each button adds
  // the "active" class while its key is held. Delivered to <body> by
  // the window-level key fallback — no focus tricks, no new API.
  const [activeKey, setActiveKey] = morphState("");

  function keyDown(e):void {
    if (e.repeat) return;
    if (e.key === "0") { setActiveKey("0"); pressDigit(0); }
    else if (e.key === "1") { setActiveKey("1"); pressDigit(1); }
    else if (e.key === "2") { setActiveKey("2"); pressDigit(2); }
    else if (e.key === "3") { setActiveKey("3"); pressDigit(3); }
    else if (e.key === "4") { setActiveKey("4"); pressDigit(4); }
    else if (e.key === "5") { setActiveKey("5"); pressDigit(5); }
    else if (e.key === "6") { setActiveKey("6"); pressDigit(6); }
    else if (e.key === "7") { setActiveKey("7"); pressDigit(7); }
    else if (e.key === "8") { setActiveKey("8"); pressDigit(8); }
    else if (e.key === "9") { setActiveKey("9"); pressDigit(9); }
    else if (e.key === "+") { setActiveKey("+"); pressOp(1); }
    else if (e.key === "-") { setActiveKey("-"); pressOp(2); }
    else if (e.key === "*") { setActiveKey("*"); pressOp(3); }
    else if (e.key === "x") { setActiveKey("x"); pressOp(3); }
    else if (e.key === "/") { setActiveKey("/"); pressOp(4); }
    else if (e.key === "Enter" || e.key === "=") { setActiveKey("Enter"); pressEquals(); }
    else if (e.key === ".") { setActiveKey("."); pressDot(); }
    else if (e.key === "%") { setActiveKey("%"); pressPct(); }
    else if (e.key === "Backspace" || e.key === "Escape") { setActiveKey("clear"); pressClear(); }
    else if (e.key === "c") { setActiveKey("clear"); pressClear(); }
  }

  function keyUp(e):void {
    setActiveKey("");
  }

  return (
    <body onKeyDown={(e) => keyDown(e)} onKeyUp={(e) => keyUp(e)}>
      <div className="app" id="app">
        <div className="display" id="display">
          <div className="expr" id="expr">{op !== 0 && <span>{acc}{" "}{opSym}</span>}{done === 1 && <span>{histA}{" "}{histOp}{" "}{histB}{" "}=</span>}</div>
          <div className="value" id="value">{cur}</div>
        </div>

        <div className="keys" id="keys">
          <div className="row" id="row1">
            <button className="key fn" id="k-clear" style={{ backgroundColor: activeKey === "clear" ? "#2e3852" : "#141a26" }} onClick={() => pressClear()}>AC</button>
            <button className="key fn" id="k-neg"   onClick={() => pressNeg()}>+/−</button>
            <button className="key fn" id="k-pct" style={{ backgroundColor: activeKey === "%" ? "#2e3852" : "#141a26" }} onClick={() => pressPct()}>%</button>
            <button className="key op" id="k-div" style={{ backgroundColor: activeKey === "/" ? "#4a3a1a" : "#2a210f" }} onClick={() => pressOp(4)}>÷</button>
          </div>
          <div className="row" id="row2">
            <button className="key" id="k-7" style={{ backgroundColor: activeKey === "7" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(7)}>7</button>
            <button className="key" id="k-8" style={{ backgroundColor: activeKey === "8" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(8)}>8</button>
            <button className="key" id="k-9" style={{ backgroundColor: activeKey === "9" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(9)}>9</button>
            <button className="key op" id="kMul" style={{ backgroundColor: activeKey === "*" || activeKey === "x" ? "#4a3a1a" : "#2a210f" }} onClick={() => pressOp(3)}>×</button>
          </div>
          <div className="row" id="row3">
            <button className="key" id="k-4" style={{ backgroundColor: activeKey === "4" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(4)}>4</button>
            <button className="key" id="k-5" style={{ backgroundColor: activeKey === "5" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(5)}>5</button>
            <button className="key" id="k-6" style={{ backgroundColor: activeKey === "6" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(6)}>6</button>
            <button className="key op" id="kSub" style={{ backgroundColor: activeKey === "-" ? "#4a3a1a" : "#2a210f" }} onClick={() => pressOp(2)}>−</button>
          </div>
          <div className="row" id="row4">
            <button className="key" id="k-1" style={{ backgroundColor: activeKey === "1" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(1)}>1</button>
            <button className="key" id="k-2" style={{ backgroundColor: activeKey === "2" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(2)}>2</button>
            <button className="key" id="k-3" style={{ backgroundColor: activeKey === "3" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(3)}>3</button>
            <button className="key op" id="kAdd" style={{ backgroundColor: activeKey === "+" ? "#4a3a1a" : "#2a210f" }} onClick={() => pressOp(1)}>+</button>
          </div>
          <div className="row" id="row5">
            <button className="key zero" id="k-0" style={{ backgroundColor: activeKey === "0" ? "#2e3852" : "#1b2130" }} onClick={() => pressDigit(0)}>0</button>
            <button className="key" id="kDot" style={{ backgroundColor: activeKey === "." ? "#2e3852" : "#1b2130" }} onClick={() => pressDot()}>.</button>
            <button className="key eq" id="kEq" style={{ backgroundColor: activeKey === "Enter" || activeKey === "=" ? "#5a66dd" : "#6d7cff" }} onClick={() => pressEquals()}>=</button>
          </div>
        </div>
      </div>
    </body>
  )
}