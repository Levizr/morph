import { cart, setCart, clearCart } from './ShopStore.mx'

export function CartBar() {
  function clear() {
    setCart(0)
    clearCart.emit({ cart: cart })
  }
  return (
    <div className="cartbar">
      <text className="cart-total">Cart total: ${cart}</text>
      <button className="btn btn-clear" onClick={() => clear()}>Clear cart</button>
    </div>
  )
}
