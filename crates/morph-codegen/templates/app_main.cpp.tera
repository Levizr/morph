int main(int argc, char** argv) {
    for (int i = 1; i < argc; ++i) {
        if (std::strcmp(argv[i], "--morph-self-test") == 0) {
            return morph_self_test();
        }
    }
    glfwSetErrorCallback(glfw_error_cb);
    if (!glfwInit()) {
        fprintf(stderr, "[morph] glfwInit() failed\n");
        return 1;
    }

    auto& wm = WindowManager::get();
    auto lastFrameTime = std::chrono::steady_clock::now();

{% if keyframe_code %}
{{ keyframe_code }}

{% endif %}
{{ window_code }}

    // Per-window vsync is set in the MorphWindow constructor on each
    // window's own context (creation order must not matter), and the
    // registry pump binds each context before rendering — no global
    // context assumptions here.
    wm.startAllCompositors(true);

    while (!wm.allClosed()) {
        // Block until an input event arrives, or ~16ms elapses so timers,
        // effects and CSS transitions keep advancing. Sleeping here instead of
        // spinning on glfwPollEvents() keeps idle CPU usage near 0%.
        glfwWaitEventsTimeout(0.016);
        morph::process_tasks();
        morph::run_pending_effects();

        auto now = std::chrono::steady_clock::now();
        float dt = std::chrono::duration<float>(now - lastFrameTime).count();
        lastFrameTime = now;
        if (dt > 0.1f) dt = 0.1f;

        // Pump the registry (not a static window list) so dynamically
        // created windows update + render; reap X-button-closed windows.
        wm.pump(dt);
        wm.sweepClosed();
    }

    morph::destroy_all_effects();
    wm.stopAllCompositors();
    // glfwTerminate() runs inside ~WindowManager after every window is
    // destroyed, so GLFW calls during teardown still see a live library.
    return 0;
}
