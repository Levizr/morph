// Generated by Morph — do not edit
#include "core/window_manager.h"
#include "core/renderer.h"
{% for header in headers %}
#include "{{ header }}"
{% endfor %}

{% if dev_mode %}
#define MORPH_DEV
{% endif %}

int main() {
    auto& wm = WindowManager::get();

{% for win in windows %}
    MorphWindow* win_{{ win.window_id }} = new MorphWindow(
        "{{ win.title }}", {{ win.width }}, {{ win.height }},
        {{ "true" if win.visible else "false" }}
    );
    wm.registerWindow("{{ win.window_id }}", win_{{ win.window_id }});
{% endfor %}

    while (!wm.allClosed()) {
        glfwPollEvents();
{% for win in windows %}
        if (win_{{ win.window_id }}->isVisible())
            win_{{ win.window_id }}->render();
{% endfor %}
    }
    return 0;
}
