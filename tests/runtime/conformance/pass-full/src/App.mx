import "./style.css"
import { morphState, morphEffect } from 'morph'

export const windowConfig = { title: "PassFull", width: 800, height: 600 }

export default function App() {
  const [count, setCount] = morphState(0)
  const [items, setItems] = morphState(["a", "b"])
  const [userName, setUserName] = morphState("Ada")
  morphEffect(() => {
    console.log(count)
  })
  const label = `count is ${count}`
  const shown = count > 10 ? "many" : label
  const nick = userName ?? "anon"
  const pair = [1, 2]
  const doubled = [...items, "c"]
  items.push("d")
  const upper = nick.toUpperCase()
  const hasA = nick.includes("a")
  let total = 0
  for (const n of [1, 2, 3]) {
    total += n
  }
  const wide = "x" in { x: 1 }
  // Bare string-literal const: the snippet is only a directive prologue,
  // which must still surface as a `const` statement.
  const badge = "ok"
  // Body-level branch over a mutable local, plus a loop (above) — both
  // lower into the component's setup effect. One local per signal type
  // the inference produces (string / bool / double / JsArray).
  let level = "low"
  let flag = false
  let ratio = 0.5
  let opts = [1, 2]
  if (count > 2) {
    level = "high"
    flag = true
    ratio += 0.25
    opts = [3, 4]
  }
  // Loop inside a helper: `acc += it` must ToNumber the JsValue element.
  function sumOf(nums: number[]): number {
    let acc = 0
    for (const it of nums) {
      acc += it
    }
    return acc
  }
  return (
    <body>
      <div className="screen">
        <div className="panel" style={{ color: "red", backgroundColor: "#16213a" }}>
          {shown} {upper} {nick} {pair[0]} {pair[1]} {total} {wide ? "y" : "n"} {badge} {level}{" "}
          {flag ? "Y" : "N"} {ratio} {opts[0]} {sumOf([4, 5])}
        </div>
        <div className="feed">
          {doubled.map((d) => (<span key={d}>{d}</span>))}
        </div>
        <button onClick={() => setCount(count + 1)}>more</button>
      </div>
    </body>
  )
}
