export const windowConfig = { title: "pass-control-flow", width: 800, height: 600 }

// Numeric switch and object for...in stay covered here; string switch and
// array for...in have dedicated conformance fixtures.
export default function App() {
  const level = 2
  let label = ""
  switch (level) {
    case 1:
      label = "one"
      break
    case 2:
      label = "two"
      break
    default:
      label = "other"
  }

  const obj = { a: 1, b: 2 }
  let keys = ""
  for (const key in obj) {
    keys = keys + key
  }

  return (
    <body>
      <div>{label} {keys}</div>
    </body>
  )
}
