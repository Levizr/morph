import { morphEffect } from 'morph'

export const windowConfig = { title: "fail-object-fn", width: 800, height: 600 }

export default function App() {
  const cleanup = () => console.log("cleanup")
  // JsObject fields cannot store closures; this passes parsing but cannot
  // compile, so check rejects it before codegen.
  const handlers = { cleanup }
  morphEffect(handlers.cleanup, [])
  return (<body><text>function-valued object</text></body>)
}
