export const windowConfig = { title: "fail-const-init", width: 800, height: 600 }

export default function App() {
  // Class expressions still have no lowering; arrow/function/object consts
  // are covered by pass-const-inits.
  const C = class { greet() { return "hi" } }
  return (
    <body>
      <div>{C.name}</div>
    </body>
  )
}
