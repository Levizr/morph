import { morphState, Window, useWindow } from 'morph'

export const windowConfig = { title: "pass-window", width: 640, height: 480 }

// Every supported handle shape lowers to registry calls: lazy
// component-body consts, direct chained calls, and `Window`-annotated
// helper params. A helper must carry the annotation — untyped params are
// just numbers, not handles.
function retitle(w: Window, title: string) {
  w.title = title
  w.navigate("/settings")
  return w.closed
}

export default function App() {
  const [status, setStatus] = morphState("idle")
  const win = useWindow()
  // Late-assigned handle: reads before the assignment are `undefined`
  // (and handle operations are safe no-ops), then every later read sees
  // the assigned window.
  let late
  console.log(late)

  return (
    <body>
      <button onClick={() => { win.title = "local"; setStatus("local") }}>local write</button>
      <button onClick={() => { useWindow().title = "direct"; setStatus("direct") }}>direct write</button>
      <button onClick={() => { new Window("/settings", { width: 400 }).title = "fresh"; setStatus("fresh") }}>new write</button>
      <button onClick={() => { const shut = retitle(useWindow(), "helper"); setStatus(shut ? "closed" : "open") }}>helper</button>
      <button onClick={() => { late = new Window("/settings", { width: 400 }); late.title = "late"; setStatus("late") }}>late assign</button>
      <button onClick={() => { const shut = late.closed; late.navigate("/settings"); setStatus(shut ? "late-closed" : "late-open") }}>late read</button>
      <button onClick={() => { late.close(); setStatus("late-closed") }}>late close</button>
      <div>{win.title} {late.title} {late.closed ? "late-closed" : "late-open"} {status}</div>
    </body>
  )
}
