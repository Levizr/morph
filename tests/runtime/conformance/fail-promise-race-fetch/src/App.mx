export const windowConfig = { title: "fail-promise-race-fetch", width: 800, height: 600 }

export default function App() {
  // `fetch` is pending work; only already-settled values can participate in
  // the eager `race`/`any` lowering.
  async function load() {
    const value = await Promise.race([fetch("http://127.0.0.1/")])
    console.log(value)
  }
  return (
    <body>
      <button onClick={load}>load</button>
    </body>
  )
}
