import { morphEffect } from 'morph'
import { morphState, Window, useWindow } from 'morph'
import { mountSettings, unmountSettings } from './native.cpp'

export const windowConfig = { title: "Route Test", width: 640, height: 480 }

export default function App() {
  const [status, setStatus] = morphState("idle")
  morphEffect(() => { const w = useWindow(); w.navigate("/auth/login") }, [])  // TEMP navigate proof

  return (
    <body>
      <div className="title" id="title">routes — manifest scan + RID interning</div>
      <button id="btn-mount" onClick={() => mountSettings()}>mount settings</button>
      <button id="btn-unmount" onClick={() => unmountSettings()}>unmount settings</button>
      <button id="btn-login" onClick={() => { const w = new Window("/auth/login", { width: 420, height: 300 }) }}>open login (JSX)</button>
      <button id="btn-set1" onClick={() => { const a = new Window("/settings", { width: 500, height: 400, data: { userId: 1 } }) }}>settings user 1</button>
      <button id="btn-set2" onClick={() => { const b = new Window("/settings", { width: 500, height: 400, data: { userId: 2 } }) }}>settings user 2</button>
      <button id="btn-title" onClick={() => { const w = useWindow(); w.title = "Route Test!" }}>retitle (useWindow)</button>
      <button id="btn-go" onClick={() => { const w = useWindow(); w.navigate("/auth/login") }}>go login (navigate)</button>
      <div className="value" id="status">{status}</div>
    </body>
  )
}
